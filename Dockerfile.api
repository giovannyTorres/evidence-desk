# syntax=docker/dockerfile:1.7
FROM python:3.12.14-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=secret,id=proxy_ca,target=/run/proxy-ca.pem \
    if [ -f /run/proxy-ca.pem ]; then SSL_CERT_FILE=/run/proxy-ca.pem uv sync --frozen --no-dev --no-cache; else uv sync --frozen --no-dev --no-cache; fi
COPY --chown=10001:10001 services services
COPY --chown=10001:10001 fixtures fixtures
ENV PYTHONPATH=/app/services/api PATH=/app/.venv/bin:$PATH
RUN useradd --uid 10001 --create-home app
USER app
EXPOSE 8000
CMD ["uvicorn", "evidence.main:app", "--host", "0.0.0.0", "--port", "8000"]
