{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "8293435188763405396"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "name": {
      "type": "string",
      "defaultValue": "evidence-desk"
    },
    "apiImage": {
      "type": "string"
    },
    "webImage": {
      "type": "string"
    },
    "postgresHost": {
      "type": "string"
    },
    "databaseUrl": {
      "type": "securestring"
    },
    "openaiApiKey": {
      "type": "securestring",
      "defaultValue": ""
    },
    "geminiApiKey": {
      "type": "securestring",
      "defaultValue": ""
    },
    "mode": {
      "type": "string",
      "defaultValue": "DEMO"
    },
    "provider": {
      "type": "string",
      "defaultValue": "openai"
    },
    "model": {
      "type": "string",
      "defaultValue": "gpt-4.1-mini"
    },
    "publicOrigin": {
      "type": "string"
    }
  },
  "variables": {
    "commonEnv": [
      {
        "name": "DATABASE_URL",
        "secretRef": "database-url"
      },
      {
        "name": "OPENAI_API_KEY",
        "secretRef": "openai-key"
      },
      {
        "name": "GEMINI_API_KEY",
        "secretRef": "gemini-key"
      },
      {
        "name": "MODE",
        "value": "[parameters('mode')]"
      },
      {
        "name": "PROVIDER",
        "value": "[parameters('provider')]"
      },
      {
        "name": "MODEL",
        "value": "[parameters('model')]"
      },
      {
        "name": "PUBLIC_ORIGIN",
        "value": "[parameters('publicOrigin')]"
      },
      {
        "name": "COOKIE_SECURE",
        "value": "true"
      },
      {
        "name": "DEMO_LOGIN_ENABLED",
        "value": "[if(equals(parameters('mode'), 'DEMO'), 'true', 'false')]"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-env', parameters('name'))]",
      "location": "[parameters('location')]",
      "properties": {}
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 3101,
            "transport": "http",
            "allowInsecure": false
          },
          "secrets": [
            {
              "name": "database-url",
              "value": "[parameters('databaseUrl')]"
            },
            {
              "name": "openai-key",
              "value": "[parameters('openaiApiKey')]"
            },
            {
              "name": "gemini-key",
              "value": "[parameters('geminiApiKey')]"
            }
          ]
        },
        "template": {
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          },
          "containers": [
            {
              "name": "web",
              "image": "[parameters('webImage')]",
              "env": [
                {
                  "name": "API_URL",
                  "value": "http://localhost:8000"
                }
              ],
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "probes": [
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/api/health",
                    "port": 3101
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10
                }
              ]
            },
            {
              "name": "api",
              "image": "[parameters('apiImage')]",
              "env": "[variables('commonEnv')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "probes": [
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/api/health",
                    "port": 8000
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10
                }
              ]
            },
            {
              "name": "worker",
              "image": "[parameters('apiImage')]",
              "command": [
                "python",
                "services/worker/main.py"
              ],
              "env": "[variables('commonEnv')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]"
      ]
    }
  ],
  "outputs": {
    "hostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('name')), '2024-03-01').configuration.ingress.fqdn]"
    },
    "databasePrerequisite": {
      "type": "string",
      "value": "[format('{0}: PostgreSQL with vector extension and TLS required; supplied externally', parameters('postgresHost'))]"
    }
  }
}