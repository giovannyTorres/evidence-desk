MODE=DEMO
DATABASE_URL=postgresql+psycopg://evidence:evidence@localhost:5541/evidence
PROVIDER=openai
MODEL=gpt-4.1-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
COOKIE_SECURE=false
DEMO_LOGIN_ENABLED=true
MODEL_TIMEOUT=30
MODEL_CONCURRENCY=4
PUBLIC_ORIGIN=http://localhost:3101
OTEL_CONSOLE=false
ONTOLOGY_MODE=off
# Application-reviewed snapshots, one per org/mode. Pin the exact file digest.
# ONTOLOGY_SNAPSHOTS={"aurora:LIVE":{"path":"/reviewed/aurora.json","sha256":"<64 lowercase hex>"}}
AUTO_ONTOLOGY_URL=
AUTO_ONTOLOGY_API_TOKEN=
# Optional scoped origins with token environment-variable references (never tokens in plans).
# AUTO_ONTOLOGY_CONNECTIONS={"aurora:LIVE":{"url":"http://127.0.0.1:3210","token_env":"AO_AURORA_API_TOKEN"},"meridian:LIVE":{"url":"http://127.0.0.1:3211","token_env":"AO_MERIDIAN_API_TOKEN"}}
ONTOLOGY_TIMEOUT=5
